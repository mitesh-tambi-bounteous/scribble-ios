# Copy this file to .env for local dev: `cp .env.example .env`
# Defaults below target the local docker-compose Postgres started by `npm run dev`.

# Provider select: stub (default, zero deps) | direct | claude | bedrock
CLAUDE_PROVIDER=stub
# Direct Anthropic API (CLAUDE_PROVIDER=direct|claude) - server-side only
ANTHROPIC_API_KEY=
# Bedrock (CLAUDE_PROVIDER=bedrock) - AWS creds via standard chain
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=  (or a profile / IAM role)

# ─── Database (scribl-db-wiring) ───
# Local dev default: docker-compose Postgres (see docker-compose.yml).
# Override with Neon serverless Postgres for cloud/shared dev. Neon format:
#   postgresql://<user>:<pw>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://scribl:scribl@localhost:5433/scribl
# Separate DB/branch for integration tests
TEST_DATABASE_URL=
# Backend store selector: "postgres" (live) or unset/"mock" (in-memory)
SCRIBL_DATA_MODE=postgres
# Port for the local API runner (backend/local-server.ts)
PORT=8787

# ─── App -> API (scribl-db-wiring) ───
# "http" to hit the live API, "mock" (default) for in-memory
EXPO_PUBLIC_API_MODE=http
# Base URL of the local API runner or deployed API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Session restore: "1" restores a persisted login on launch; unset/"0" (default)
# always shows the Login screen on cold launch.
EXPO_PUBLIC_RESTORE_SESSION=0

# ─── Speech-to-text (/transcribe) ───
# "stub" (default; fixed transcript) | "cloud" (OpenAI whisper-1; needs STT_API_KEY or OPENAI_API_KEY)
STT_PROVIDER=stub
# STT_API_KEY=
# STT_MODEL=whisper-1

# ─── AI-enhance (T4, #33) — DISABLED by default (client feedback) ───
# The AI drawing-background / enhancement pipeline is OFF. scribl runs as a
# pure hand-drawing app. Re-enable by flipping BOTH flags below:
#   1. ENHANCE_ENABLED (backend) — gates the pipeline; when falsy nothing runs.
#   2. EXPO_PUBLIC_AI_ENABLED (frontend) — gates all generative UI (toggle,
#      background-prompt field, regenerate) and the pending/failed chrome.
# Leave both off = no live image calls, no generative UI, no "AI unavailable".
ENHANCE_ENABLED=
# Background image provider: stub (default, zero deps) | openai
# Set to "openai" + OPENAI_API_KEY (and ENHANCE_ENABLED) for gpt-image-1.
IMAGE_PROVIDER=stub
OPENAI_API_KEY=
# Frontend AI UI kill-switch. Unset/"0" (default) = no AI affordances.
# Set to "1" (with ENHANCE_ENABLED) to restore the enhancement UI.
EXPO_PUBLIC_AI_ENABLED=0
