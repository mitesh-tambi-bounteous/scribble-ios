{
  "name": "@scribl/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Thin AWS backend (API Gateway + Lambda + DynamoDB) for the Scribl POC.",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "cdk": "cdk",
    "api": "ts-node -r tsconfig-paths/register local-server.ts",
    "db:bootstrap": "ts-node -r tsconfig-paths/register scripts/bootstrap.ts",
    "db:reset": "ts-node -r tsconfig-paths/register scripts/reset.ts",
    "db:prompts": "ts-node -r tsconfig-paths/register scripts/prompts.ts",
    "db:seed-journey": "ts-node -r tsconfig-paths/register scripts/seed-journey.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "aws-cdk": "^2.150.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@neondatabase/serverless": "^0.10.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "sharp": "^0.33.5"
  }
}
